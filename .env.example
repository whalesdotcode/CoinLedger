# Port the web server listens on
PORT=3000

# SQLite database file (created automatically)
DATABASE_PATH=./data/coinledger.db

# Default reporting currency for new users (any CoinGecko vs_currency, e.g. usd, eur, gbp)
DEFAULT_CURRENCY=usd

# CoinGecko price provider. Keys stay on the server and are never sent to the browser.
#   COINGECKO_PLAN=demo  -> free Demo key from https://www.coingecko.com/en/api (recommended)
#   COINGECKO_PLAN=pro   -> paid Pro key (uses pro-api.coingecko.com)
#   COINGECKO_PLAN=public with an empty key -> keyless public API (heavily rate limited)
COINGECKO_PLAN=demo
COINGECKO_API_KEY=

# How long fetched prices are reused before asking the provider again
PRICE_TTL_SECONDS=60

# Set to "production" behind HTTPS so session cookies are marked Secure
NODE_ENV=development

# Set to "false" to disable new sign-ups after you have created your account
ALLOW_REGISTRATION=true
